{
    "fields": {
        "status": {
            "options": [
                "Nuevo Lead",
                "En Calificación",
                "Calificado",
                "En Enfriamiento/Contactado",
                "Cierre Exitoso",
                "Converted",
                "Dead"
            ],
            "default": "Nuevo Lead",
            "style": {
                "Nuevo Lead": null,
                "En Calificación": "primary",
                "Calificado": "info",
                "En Enfriamiento/Contactado": "warning",
                "Cierre Exitoso": "success",
                "Converted": "success",
                "Dead": "danger"
            }
        },
        "source": {
            "options": [
                "",
                "Facebook Ads",
                "Instagram Ads",
                "Formulario Web",
                "WhatsApp",
                "SMS",
                "Telegram",
                "Manual",
                "Referido"
            ]
        },
        "creditPdf": {
            "type": "file",
            "accept": [
                "application/pdf"
            ],
            "audited": true
        },
        "creditScore": {
            "type": "int",
            "min": 0,
            "max": 999
        },
        "totalDebt": {
            "type": "currency"
        },
        "overdueDebt": {
            "type": "currency"
        },
        "defaultHistory": {
            "type": "text",
            "rows": 5
        },
        "creditSummary": {
            "type": "text",
            "rows": 8
        },
        "creditParseStatus": {
            "type": "enum",
            "options": [
                "",
                "Procesando",
                "Completado",
                "Error"
            ],
            "style": {
                "Completado": "success",
                "Error": "danger",
                "Procesando": "warning"
            }
        },
        "avatarUrl": {
            "type": "varchar",
            "maxLength": 500,
            "readOnlyAfterCreate": false,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "qualificationStatus": {
            "type": "enum",
            "options": [
                "",
                "Califica",
                "No califica",
                "Revisión Manual"
            ],
            "style": {
                "Califica": "success",
                "No califica": "danger",
                "Revisión Manual": "warning"
            },
            "audited": true,
            "isSorted": false
        },
        "suggestedService": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "qualificationReasons": {
            "type": "text",
            "rows": 8
        },
        "creditorCount": {
            "type": "int",
            "min": 0
        },
        "maxDaysOverdue": {
            "type": "int",
            "min": 0
        },
        "defaultCount": {
            "type": "int",
            "min": 0
        },
        "monthlyIncome": {
            "type": "currency",
            "audited": true
        },
        "preferredChannel": {
            "type": "enum",
            "options": [
                "",
                "Teléfono",
                "WhatsApp",
                "Telegram",
                "Correo"
            ],
            "audited": true,
            "isSorted": false
        },
        "telegramUsername": {
            "type": "varchar",
            "maxLength": 64
        },
        "telegramChatId": {
            "type": "varchar",
            "maxLength": 32,
            "index": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "telegramStartToken": {
            "type": "varchar",
            "maxLength": 32,
            "index": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "doNotContact": {
            "type": "bool",
            "default": false,
            "audited": true
        }
    }
}
